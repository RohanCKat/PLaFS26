
(* Add exercise 3 *)

let n_left = { data <= 12; left <= 0; right <= 0}    (* 0 in head signals null *)
in let n_right = { data <= 44; left <= 0; right <= 0}
in let n_root = { data <= 33; left <= n_left ; right <= n_right }
in let t1 = { root <= n_root ; length <= 3} 
in let add_bt = proc (t) {
if number?(t.root)
then proc (y) {
  t.root <= { data <= y; left <= 0; right <= 0}
}
else 
letrec f(x) = proc (y) {
  if (x.data = y)
  then 0
  else (
    if (x.data >> y)
    then (
      if number?(x.left)
      then x.left <= { data <= y; left <= 0; right <= 0}
      else ((f x.left) y)
    )
    else (
      if number?(x.right)
      then x.right <= { data <= y; left <= 0; right <= 0}
      else ((f x.right) y)
    )
  )
}
in (f t.root)
}
in begin
     ((add_bt t1) 23);
     t1.length <= t1.length+1;
     debug(t1)		
   end