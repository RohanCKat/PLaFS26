(* Example 4 *)

(* counterc *)
class counterc extends object { 
  field c
  method initialize() { c:=7 }
  method add(i) { c:=c+i }
  method bump() { send self add(1) }
  method read() { c }
}

(* reset counter *)
class resetc extends counterc {
  field v
  method reset() { c:=v }
  method setReset(i) { v:=i }
}

(* backup counter *)
class bkpcc extends resetc {
  field b
  method initialize() {
    begin
      super initialize();
      b:=12
    end
  }
  method add(i) {
    begin
      send self backup();
      super add(i)
    end
  }
  method add(i, j) {
    begin
      send self backup();
      super add(i);
      super add(j)
    end
  }
  method add(i, j, k) {
    begin
      send self backup();
      super add(i);
      super add(j);
      super add(k)
    end
  }
  method backup() { b:=c }
  method restore() { c:=b}
 }

(* main expression *)


let o = new bkpcc() 
in begin
     send o restore();
     send o add(2,3); 
     send o read()
   end
   
   